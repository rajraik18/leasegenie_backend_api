# LeaseGenie API Configuration - HYBRID deployment
#
# In this deployment:
#   - api + worker run in Docker containers
#   - Postgres, Redis, Ollama run as native installs on the host machine
#
# Containers reach the host via `host.docker.internal` (Docker Desktop)
# or via the `host-gateway` extra_hosts entry (Linux without Docker Desktop).

# ---------------------------------------------------------------------------
# Database - PostgreSQL with pgvector running on the HOST
# ---------------------------------------------------------------------------
# This URL is what the Docker containers use. From inside a container,
# `host.docker.internal` resolves to your Windows/Mac/Linux host machine,
# where Postgres is installed natively.
#
# REQUIREMENTS on the host:
#   1. PostgreSQL 16+ installed and running
#   2. pgvector extension installed (see DEPLOYMENT.md)
#   3. listen_addresses = '*' in postgresql.conf (not just localhost)
#   4. pg_hba.conf allows connections from 172.16.0.0/12 (Docker bridge)
#   5. Database `leasegenie` and user `leasegenie` created
#
# Note on URL-encoding: if your password contains @, :, /, or other URL-
# reserved characters, percent-encode them. e.g. p@ssword -> p%40ssword.
#
# IMPORTANT: replace <YOUR_DB_USER> and <YOUR_DB_PASSWORD> with strong, unique
# values before deploying. Do NOT ship these placeholders to production.
DATABASE_URL=postgresql+psycopg2://<YOUR_DB_USER>:<YOUR_DB_PASSWORD>@host.docker.internal:5432/leasegenie

# These three are kept for reference / documentation. They are NOT used by
# docker-compose anymore (no postgres service to init). Leave them so
# scripts/db.sh and other tools can read them.
# IMPORTANT: replace placeholders before deploying.
POSTGRES_USER=<YOUR_DB_USER>
POSTGRES_PASSWORD=<YOUR_DB_PASSWORD>
POSTGRES_DB=leasegenie

# ---------------------------------------------------------------------------
# Celery / Redis - Redis running on the HOST
# ---------------------------------------------------------------------------
# REQUIREMENTS on the host:
#   1. Redis 7+ installed and running on port 6379
#   2. bind 0.0.0.0 (or comment out the bind line) in redis.conf
#   3. protected-mode no  (for dev) OR set a password and add it to the URL
CELERY_BROKER_URL=redis://host.docker.internal:6379/0
CELERY_RESULT_BACKEND=redis://host.docker.internal:6379/1
CELERY_TASK_ALWAYS_EAGER=false

# ---------------------------------------------------------------------------
# Ollama - LLM server running on the HOST
# ---------------------------------------------------------------------------
# REQUIREMENTS on the host:
#   1. Ollama installed (https://ollama.com/download/windows)
#   2. Set OLLAMA_HOST=0.0.0.0:11434 in your environment so it accepts
#      connections from the docker network. By default Ollama only listens
#      on 127.0.0.1, which Docker containers can't reach.
#   3. Pull the required models:
#        ollama pull qwen2.5:14b-instruct-q5_K_M
#        ollama pull nomic-embed-text
EXTRACTOR_BACKEND=ollama

OLLAMA_BASE_URL=http://host.docker.internal:11434

# Chat model for extraction - must support JSON mode
#   qwen2.5:14b-instruct-q5_K_M  -> ~10 GB RAM (default, good for laptops)
#   qwen2.5:32b-instruct-q5_K_M  -> ~22 GB RAM (recommended for workstations)
#   llama3.1:70b-instruct-q4_K_M -> ~48 GB RAM (best accuracy)
OLLAMA_MODEL=qwen2.5:14b-instruct-q5_K_M
OLLAMA_TIMEOUT_SECONDS=180
OLLAMA_NUM_CTX=32768
OLLAMA_TEMPERATURE=0.0

# Embedding model - must match the VECTOR(N) dimension in scripts/db/schema.sql
#   nomic-embed-text   ->  768 dim (default, legal-text tolerant, ~270MB)
#   bge-large-en-v1.5  -> 1024 dim (slightly better recall, ~1.3GB)
#
# IMPORTANT: changing this requires updating scripts/db/schema.sql VECTOR(N)
# and re-embedding all clauses.
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_EMBED_DIM=768

# ---------------------------------------------------------------------------
# File storage (inside the container, persisted via api_data volume)
# ---------------------------------------------------------------------------
UPLOAD_DIR=./uploads
EXPORT_DIR=./exports
BRD_PATH=./data/LeaseGenie_BRD.xlsx

# Upload limits - enforced at POST /api/v1/extract/pdf
MAX_UPLOAD_SIZE_MB=100
MAX_UPLOAD_TOTAL_MB=500
MAX_PDFS_PER_REQUEST=8

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
API_V1_PREFIX=/api/v1
DEBUG=true
API_PORT=8000
