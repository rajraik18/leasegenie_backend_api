# LeaseGenie API Configuration - native deployment
#
# All components run on the local machine:
#   - api + worker run as Python processes from .\.venv (managed by
#     scripts\start.ps1 / stop.ps1 / restart.ps1, or by the Windows
#     services registered via deploy\windows\install-services.ps1)
#   - Postgres + pgvector, Redis, and Ollama are host-installed services
#     reachable on localhost.

# ---------------------------------------------------------------------------
# Database - PostgreSQL with pgvector running on the host
# ---------------------------------------------------------------------------
# REQUIREMENTS on the host:
#   1. PostgreSQL 16+ installed and running on port 5432
#   2. pgvector extension installed (see DEPLOYMENT.md)
#   3. Database `leasegenie` and a dedicated user created
#
# Note on URL-encoding: if your password contains @, :, /, or other URL-
# reserved characters, percent-encode them. e.g. p@ssword -> p%40ssword.
#
# IMPORTANT: replace <YOUR_DB_USER> and <YOUR_DB_PASSWORD> with strong, unique
# values before deploying. Do NOT ship these placeholders to production.
DATABASE_URL=postgresql+psycopg2://<YOUR_DB_USER>:<YOUR_DB_PASSWORD>@localhost:5432/leasegenie

# These three are kept for reference / documentation only. The application
# reads DATABASE_URL above; these are convenient for psql / pg_dump scripts.
# IMPORTANT: replace placeholders before deploying.
POSTGRES_USER=<YOUR_DB_USER>
POSTGRES_PASSWORD=<YOUR_DB_PASSWORD>
POSTGRES_DB=leasegenie

# ---------------------------------------------------------------------------
# Celery / Redis - Redis running on the host
# ---------------------------------------------------------------------------
# REQUIREMENTS on the host:
#   1. Redis 7+ installed and running on port 6379
#   2. Default localhost binding is fine
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TASK_ALWAYS_EAGER=false

# ---------------------------------------------------------------------------
# Ollama - LLM server running on the host
# ---------------------------------------------------------------------------
# REQUIREMENTS on the host:
#   1. Ollama installed (https://ollama.com/download)
#   2. Default 127.0.0.1 binding works -- the API talks to it on localhost
#   3. Pull the required models:
#        ollama pull qwen2.5:14b-instruct-q5_K_M
#        ollama pull nomic-embed-text
EXTRACTOR_BACKEND=ollama

OLLAMA_BASE_URL=http://localhost:11434

# Chat model for extraction - must support JSON mode
#   qwen2.5:14b-instruct-q5_K_M  -> ~10 GB RAM (default, good for laptops)
#   qwen2.5:32b-instruct-q5_K_M  -> ~22 GB RAM (recommended for workstations)
#   llama3.1:70b-instruct-q4_K_M -> ~48 GB RAM (best accuracy)
OLLAMA_MODEL=qwen2.5:14b-instruct-q5_K_M
OLLAMA_TIMEOUT_SECONDS=180
OLLAMA_NUM_CTX=32768
OLLAMA_TEMPERATURE=0.0

# Embedding model - must match the VECTOR(N) dimension in scripts/db/schema.sql
#   nomic-embed-text   ->  768 dim (default, legal-text tolerant, ~270MB)
#   bge-large-en-v1.5  -> 1024 dim (slightly better recall, ~1.3GB)
#
# IMPORTANT: changing this requires updating scripts/db/schema.sql VECTOR(N)
# and re-embedding all clauses.
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_EMBED_DIM=768

# ---------------------------------------------------------------------------
# File storage (relative to the project root)
# ---------------------------------------------------------------------------
UPLOAD_DIR=./uploads
EXPORT_DIR=./exports
BRD_PATH=./data/LeaseGenie_BRD.xlsx

# Upload limits - enforced at POST /api/v1/extract/pdf
MAX_UPLOAD_SIZE_MB=100
MAX_UPLOAD_TOTAL_MB=500
MAX_PDFS_PER_REQUEST=8

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
API_V1_PREFIX=/api/v1
DEBUG=false
API_PORT=8000
# Bind to loopback by default so a reverse proxy (IIS / Caddy / nginx)
# terminates TLS in front. Set to 0.0.0.0 only if you intentionally expose
# uvicorn on the network with no proxy.
API_HOST=127.0.0.1
CORS_ALLOW_ORIGINS=["http://localhost:3000"]

# Bearer token shared between clients and the API. When unset, every
# endpoint is unauthenticated -- ONLY safe for local dev. Production
# deployments MUST set a strong random value here.
# Generate one: `python -c "import secrets; print(secrets.token_urlsafe(32))"`
# API_KEY=

# ---------------------------------------------------------------------------
# Worker pool (Windows: prefork is unsupported; use threads / gevent / solo)
# ---------------------------------------------------------------------------
WORKER_POOL=threads
WORKER_CONCURRENCY=4

# ---------------------------------------------------------------------------
# Celery reliability knobs (defaults are sane; override only if needed)
# ---------------------------------------------------------------------------
CELERY_TASK_TIME_LIMIT=600
CELERY_TASK_SOFT_TIME_LIMIT=540
CELERY_RESULT_EXPIRES_SECONDS=86400
